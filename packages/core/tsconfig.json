{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/agent-profile.ts",
    "src/collaboration.ts",
    "src/sync.ts",
    "src/message-authority.ts",
    "src/attachment-authority.ts",
    "src/room-memory.ts",
    "src/context-compiler.ts",
    "src/project-loop.ts",
    "src/tool-safety.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.type-test.ts"]
}

{
  "name": "native-agent-im",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc --noEmit -p packages/core/tsconfig.type-test.json && tsc --noEmit -p packages/server/tsconfig.type-test.json && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --types node vitest.config.ts",
    "lint": "eslint . --max-warnings=0",
    "verify:core-boundary": "node scripts/verify-core-boundary.mjs",
    "test": "pnpm verify:core-boundary && vitest run",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
